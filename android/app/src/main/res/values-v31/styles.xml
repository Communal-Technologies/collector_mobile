<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 took the launch window away from windowBackground and gave it to the
     platform splash screen, which centres the *launcher icon* on it — so without
     these the collector opened on the stock Flutter logo. The purple, the white
     plate and the mark are the ones the Dart splash draws; only the plate's shape is
     the device's, since it is filled to the launcher's icon mask. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_purple</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
