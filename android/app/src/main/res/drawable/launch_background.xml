<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android paints before Flutter's first frame, on API levels below 31
     where there is no platform splash screen. Black, the same ground the platform
     gives the member app, so the collector's cold start looks the same whichever
     Android it opens on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
</layer-list>
