<?xml version="1.0" encoding="utf-8"?>
<!-- The mark Android 12+ centres on the launch window: the white mark straight onto
     the brand purple, the way the member app's launch window carries its mark with no
     plate behind it. No plate also means no icon mask, and the mask was the only
     reason a shape appeared here that the Dart splash does not draw.
     The transparent canvas is the padding. The platform keeps the middle 192 of a
     288dp icon, and the mark is well inside that so it reads at the same weight as
     the one in the Dart splash rather than filling the screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="104dp"
        android:height="104dp"
        android:drawable="@drawable/brand_mark_white"
        android:gravity="center" />
</layer-list>
