<?xml version="1.0" encoding="utf-8"?>
<!-- The mark Android 12+ centres on the system splash screen, on the white plate set
     by windowSplashScreenIconBackgroundColor.
     The plate's shape belongs to the device, not to this file: it is filled to the
     launcher's icon mask, which is a rounded square on HiOS handsets and a circle on
     stock Android. Drawing a white oval in here instead does not change that — the
     mask still wins — so the Dart splash's circle is the shape the app controls and
     this is the shape the phone does.
     The transparent canvas is the padding: with a plate the platform uses a 240dp
     icon slot and keeps the middle 160dp, and the mark is sized for that. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="240dp" android:height="240dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:drawable="@drawable/brand_mark"
        android:gravity="center" />
</layer-list>
