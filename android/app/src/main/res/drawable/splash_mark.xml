<?xml version="1.0" encoding="utf-8"?>
<!-- The mark Android 12+ centres on the launch window: the white mark straight onto the
     black ground, the way the member app's launch window carries its mark with no plate
     behind it. No plate also means no icon mask, and the mask was the only reason a
     shape appeared here that the Dart splash does not draw.
     The transparent canvas is the padding. The platform crops to the middle 192 of
     the 288dp canvas and scales that back up, so what lands on screen is a little
     over three times the dp declared here — 55dp measures 174px on a 2x phone,
     the same as the member app's mark. All three apps declare this same size in their
     own splash_mark.xml, so they stay equal whatever happens to the launcher icon they
     used to inherit it from; only the two colours differ. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="55dp"
        android:height="55dp"
        android:drawable="@drawable/brand_mark_white"
        android:gravity="center" />
</layer-list>
